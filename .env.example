# ==============================================================================
# Gargoyle Gateway Environment Configuration Template
# ==============================================================================
# Copy this file to .env to override defaults for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# Server & Network
GARGOYLE_LISTEN_ADDR=:8080

# Primary Datastores
GARGOYLE_DATABASE_URL=postgres://gargoyle:gargoyle@localhost:5432/gargoyle?sslmode=disable
GARGOYLE_REDIS_URL=redis://localhost:6379/0

# Rate Limiting
GARGOYLE_RATE_LIMIT_WINDOW=1m
GARGOYLE_PRE_AUTH_RATE_LIMIT=60

# Rule-Based Abuse Detection
GARGOYLE_ABUSE_BLOCK_THRESHOLD=0.8
GARGOYLE_ABUSE_SWEEP_THRESHOLD=10
GARGOYLE_ABUSE_SWEEP_WINDOW=10s

# Machine Learning Abuse Scoring
GARGOYLE_ONNX_MODEL_PATH=abuse_model.onnx
GARGOYLE_ML_SCORE_THRESHOLD=0.8

# Admin API & Security
GARGOYLE_ADMIN_KEY=

# In-Memory Cache 
GARGOYLE_CLIENT_CACHE_TTL=30s

# Server HTTP Timeouts
GARGOYLE_READ_HEADER_TIMEOUT=5s
GARGOYLE_READ_TIMEOUT=15s
GARGOYLE_WRITE_TIMEOUT=30s
GARGOYLE_IDLE_TIMEOUT=60s
GARGOYLE_SHUTDOWN_TIMEOUT=10s
